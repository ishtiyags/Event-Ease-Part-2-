@model EventEase.Models.Booking
@{
    ViewData["Title"] = "Create Booking";
}

<h1>Create Booking</h1>
<hr />

<div class="row">
    <div class="col-md-5">
        <form asp-action="Create" method="post">
            @Html.AntiForgeryToken()
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <!-- Customer Name -->
            <div class="form-group mb-3">
                <label asp-for="CustomerName" class="form-label">Customer Name</label>
                <input asp-for="CustomerName" class="form-control" placeholder="Enter customer name" />
                <span asp-validation-for="CustomerName" class="text-danger"></span>
            </div>

            <!-- Email -->
            <div class="form-group mb-3">
                <label asp-for="Email" class="form-label">Email</label>
                <input asp-for="Email" class="form-control" placeholder="Enter email address" />
                <span asp-validation-for="Email" class="text-danger"></span>
            </div>

            <!-- Number of Tickets -->
            <div class="form-group mb-3">
                <label asp-for="NumberOfTickets" class="form-label">Number of Tickets</label>
                <input asp-for="NumberOfTickets" class="form-control" type="number" min="1" placeholder="Enter number of tickets" />
                <span asp-validation-for="NumberOfTickets" class="text-danger"></span>
            </div>

            <!-- Event Dropdown -->
            <div class="form-group mb-3">
                <label asp-for="EventId" class="form-label">Event</label>
                <select asp-for="EventId" class="form-control" asp-items="ViewBag.EventId">
                    <option value="">-- Select Event --</option>
                </select>
                <span asp-validation-for="EventId" class="text-danger"></span>
            </div>

            <!-- ✅ Venue Dropdown - WAS MISSING -->
            <div class="form-group mb-3">
                <label asp-for="VenueId" class="form-label">Venue</label>
                <select asp-for="VenueId" class="form-control" asp-items="ViewBag.VenueId">
                    <option value="">-- Select Venue --</option>
                </select>
                <span asp-validation-for="VenueId" class="text-danger"></span>
            </div>

            <!-- Booking Date - Auto set, shown as readonly -->
            <div class="form-group mb-3">
                <label class="form-label">Booking Date</label>
                <input type="text" class="form-control" value="@DateTime.Now.ToString("dd MMM yyyy")" readonly />
            </div>

            <!-- Buttons -->
            <div class="form-group mt-4">
                <input type="submit" value="Create Booking" class="btn btn-primary" />
                <a asp-action="Index" class="btn btn-secondary">Back to List</a>
            </div>

        </form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}