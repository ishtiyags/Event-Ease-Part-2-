@model IEnumerable<EventEase.Models.BookingDetailsView>
@{
    ViewData["Title"] = "Bookings";
}

<h1 class="mb-3">📋 Bookings</h1>

<!-- Search Bar -->
<form method="get" class="d-flex mb-4 gap-2">
    <input type="text"
           name="searchTerm"
           value="@ViewBag.SearchTerm"
           class="form-control w-25"
           placeholder="Search by Booking ID or Event Name..." />
    <button type="submit" class="btn btn-primary">🔍 Search</button>
    @if (!string.IsNullOrEmpty(ViewBag.SearchTerm as string))
    {
        <a href="@Url.Action("Index")" class="btn btn-secondary">✖ Clear</a>
    }
</form>

<p>
    <a asp-action="Create" class="btn btn-primary">➕ Create New Booking</a>
</p>

<table class="table table-striped table-hover">
    <thead class="table-dark">
        <tr>
            <th>Booking ID</th>
            <th>Event Name</th>
            <th>Event Date</th>
            <th>Venue</th>
            <th>Location</th>
            <th>Venue Image</th>
            <th>Booking Date</th>
            <th class="text-center">Actions</th>
        </tr>
    </thead>
    <tbody>
        @if (Model != null && Model.Any())
        {
            foreach (var item in Model)
            {
                <tr>
                    <td>@item.BookingId</td>
                    <td>@item.EventName</td>
                    <td>@item.EventDate.ToString("dd MMM yyyy")</td>
                    <td>@item.VenueName</td>
                    <td>@item.VenueLocation</td>
                    <td>
                        @if (!string.IsNullOrEmpty(item.VenueImageUrl))
                        {
                            <img src="@item.VenueImageUrl"
                                 alt="Venue Image"
                                 style="height: 50px; border-radius: 6px;" />
                        }
                        else
                        {
                            <span class="text-muted">No image</span>
                        }
                    </td>
                    <td>@item.BookingDate.ToString("dd MMM yyyy")</td>
                    <td class="text-center">
                        <a asp-action="Details" asp-route-id="@item.BookingId" class="btn btn-sm btn-info">👁 Details</a>
                        <a asp-action="Delete" asp-route-id="@item.BookingId" class="btn btn-sm btn-danger">🗑 Delete</a>
                    </td>
                </tr>
            }
        }
        else
        {
            <tr>
                <td colspan="8" class="text-center text-muted">
                    No bookings found.
                </td>
            </tr>
        }
    </tbody>
</table>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}